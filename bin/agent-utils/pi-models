#!/usr/bin/env ruby
# frozen_string_literal: true

# List provider/model pairs available to `pi`.
#
# Spawns `pi --mode rpc` headless, asks for the configured models over
# the JSONL protocol, parses each entry into a PiModel struct, then
# formats the array for display.
#
# Usage:
#   pi-models                       # formatted table (default)
#   pi-models --json | jq '.[0]'    # pretty-printed JSON array of hashes
#   pi-models --ids | head -5       # one "provider/id" per line
#   pi-models -h                    # full help
#
# Output modes (each shows a different subset of the 7 PiModel fields:
# provider, id, name, api, reasoning, contextWindow, maxTokens):
#   -t, --table   7 fields: all PiModel fields (formatted table)
#   -j, --json    7 fields: all of the above (pretty-printed JSON)
#   -i, --ids     2 fields: provider, id (formatted as "provider/id")
#   -h, --help    0 fields: prints help and exits

require "json"
require "open3"

PiModel = Data.define(
  :provider,
  :id,
  :name,
  :api,
  :reasoning,
  :contextWindow,
  :maxTokens
) do
  alias_method :context_window, :contextWindow
  alias_method :max_tokens,     :maxTokens

  def self.from_hash(raw)
    new(**raw.slice(*members.map(&:to_s)))
  end
end

RPC_GET_MODELS = { "type" => "get_available_models" }
RPC_REQUEST_ID = "list-models"

HELP_OUTPUT    = ARGV.delete("-h")     || ARGV.delete("--help")
JSON_OUTPUT    = ARGV.delete("--json") || ARGV.delete("-j")
IDS_OUTPUT     = ARGV.delete("--ids")  || ARGV.delete("-i")

def fetch_models
  Open3.popen3("pi", "--mode", "rpc", "--no-session") do |stdin, stdout, _stderr, wait_thr|
    send_rpc_command(stdin, RPC_GET_MODELS.merge("id" => RPC_REQUEST_ID))

    events = stdout.each_line(chomp: true).map { |line| JSON.parse(line) }
    response = events.detect { |e| e["id"] == RPC_REQUEST_ID && e["type"] == "response" }
    return event_to_models(response) if response

    raise "pi exited (#{wait_thr.value.exitstatus}) before responding"
  end
end

def send_rpc_command(stdin, command)
  stdin.sync = true
  stdin.puts(JSON.generate(command))
  stdin.close
end

def event_to_models(event)
  if event["success"]
    event.dig("data", "models").map { |m| PiModel.from_hash(m) }
  else
    raise "pi error: #{event['error']}"
  end
end

def help_text
  <<~HELP
    Usage: pi-models [options]

    List provider/model pairs available to \`pi\`.

    Options:
      -t, --table     Formatted table (default)
      -j, --json      Pretty-printed JSON array of model hashes
      -i, --ids       One "provider/id" per line (shell-friendly)
      -h, --help      Show this help and exit

    Examples:
      pi-models
      pi-models --json | jq '.[0]'
      pi-models --ids | head -5
      pi-models --table            # explicit default
  HELP
end

def format_table(models)
  return "No models configured. Run `pi` interactively and add a provider first.\n" if models.empty?

  columns = [
    { label: "PROVIDER",   value: ->(m) { m.provider },                 align: :left  },
    { label: "MODEL ID",   value: ->(m) { m.id },                       align: :left  },
    { label: "API",        value: ->(m) { m.api },                      align: :left  },
    { label: "REASONING",  value: ->(m) { m.reasoning ? "yes" : "no" }, align: :left  },
    { label: "CONTEXT",    value: ->(m) { m.context_window.to_s },      align: :right },
    { label: "MAX TOKENS", value: ->(m) { m.max_tokens.to_s },          align: :right },
    { label: "NAME",       value: ->(m) { m.name },                     align: :left  }
  ]

  widths = columns.map do |col|
    max_val_length = models.map { |m| col[:value].(m).length }.max
    [max_val_length, col[:label].length].max
  end

  formats = columns.each_with_index.map do |col, i|
    align_sign = col[:align] == :right ? "" : "-"
    "%#{align_sign}#{widths[i]}s"
  end.join("  ") + "\n"

  separator = widths.map { |w| "-" * w }.join("  ") + "\n"
  header = format(formats, *columns.map { |c| c[:label] })
  body_lines = models.map { |m| format(formats, *columns.map { |c| c[:value].(m) }) }

  separator + header + separator + body_lines.join + separator
end

models = fetch_models

if HELP_OUTPUT                                 # 0 fields
  puts help_text
elsif JSON_OUTPUT                              # 7 fields
  puts JSON.pretty_generate(models.map(&:to_h))
elsif IDS_OUTPUT                               # 2 fields
  models.each { |m| puts "#{m.provider}/#{m.id}" }
else                                           # 7 fields (default; --table)
  print format_table(models)
end
